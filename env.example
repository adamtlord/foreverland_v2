# Copy to .env for local/dev (docker-compose.yml) or .env.prod for production.
# .env / .env.prod are gitignored.

ENV=dev
SECRET_KEY=change-me
DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1
GOOGLE_MAPS_API_KEY=
# Optional Fernet material for SSNs. Falls back to SECRET_KEY if unset.
SSN_ENCRYPTION_KEY=
# Public Facebook meta tag. Leave empty to omit fb:app_id.
FACEBOOK_APP_ID=

# Password-reset mail (prod). Leave EMAIL_HOST empty until SMTP works.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@foreverland.com

MYSQL_HOST=db
MYSQL_DATABASE=foreverland
MYSQL_USER=mysql
MYSQL_PASSWORD=change-me-app-user

# Required for first-time MySQL/MariaDB init. MYSQL_PASSWORD is not enough.
MYSQL_ROOT_PASSWORD=change-me-root
